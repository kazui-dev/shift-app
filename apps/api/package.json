{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vp test run",
    "coverage": "vp test run --coverage",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "cf-typegen:check": "wrangler types --env-interface CloudflareBindings --check",
    "chat:initialize": "node --experimental-strip-types scripts/initialize-chat.ts",
    "directory:seed": "node --experimental-strip-types scripts/seed-student-directory.ts",
    "snapshot:refresh": "bash scripts/refresh-production-snapshot.sh"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.33",
    "@workspace/db": "workspace:*",
    "@workspace/shared": "workspace:*",
    "better-auth": "1.6.33",
    "drizzle-orm": "^0.45.4",
    "entities": "^8.1.0",
    "hono": "^4.13.13",
    "valibot": "1.5.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.153.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
