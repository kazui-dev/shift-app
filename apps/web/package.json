    "@workspace/shared": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "1.6.29",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "7.85.0",
    "valibot": "1.4.2",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
