{
  "name": "shift-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "vp run web#build",
    "dev": "vp dev",
    "lint": "vp lint .",
    "test": "vp run -r --cache test",
    "coverage": "vp run -r coverage",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "typecheck": "tsc --noEmit && vp run -r --cache typecheck",
    "check": "vp check && tsc --noEmit && vp run -r --cache typecheck",
    "knip": "vp exec knip"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "catalog:",
    "knip": "6.32.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
